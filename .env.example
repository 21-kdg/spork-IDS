# Spork-IDS Configuration

# Server Settings
SPORK_HOST=127.0.0.1
SPORK_PORT=8000
SPORK_DEBUG=false
SPORK_ENV=development

# Database Settings (defaults to local SQLite database in data/spork.db)
SPORK_DATABASE_URL=sqlite:///./data/spork.db

# Security & Authentication
# Leave empty to allow unrestricted local management, or specify a secret key for API key protection
SPORK_API_KEY=
SPORK_SECRET_KEY=spork-ids-dev-secret-change-in-production

# CORS Origins (comma-separated)
SPORK_CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# CrowdSec Integration (Optional)
# If an upstream CrowdSec LAPI daemon is running externally, configure its URL and API key
CROWDSEC_ENABLED=false
CROWDSEC_LAPI_URL=http://localhost:8080
CROWDSEC_API_KEY=
CROWDSEC_MACHINE_ID=
